# Copy to .env and edit. docker compose reads it automatically.

TZ=Europe/London

# Database (used by both the mariadb and zoneminder services)
ZM_DB_NAME=zm
ZM_DB_USER=zmuser
ZM_DB_PASS=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Image tag to run:
#   latest      newest ZoneMinder release        latest-es  the same with zmeventnotificationNg
#   dev         nightly development build (odd   dev-es     the same with zmeventnotificationNg
#               minor versions such as 1.39)
#   1.38, 1.38-es, 1.38.6 ...  stay on one release
ZM_TAG=latest

# Only used when building with compose.build.yaml
# ZM_TARGET=zm            # zm or zm-es
# ZM_CHANNEL=release      # release (newest stable), master (nightly), or e.g. release-1.38
# ZM_VERSION=             # exact package version, empty = newest in the channel
# BASE_IMAGE=debian:stable-slim   # or ubuntu:26.04

# Run as this user and group instead of www-data (33:33), e.g. the owner of your bind mounts.
# PUID=1000
# PGID=1000

# Outgoing mail. Then turn on email in ZoneMinder's Options > Email (see README).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls       # starttls, tls (port 465) or off
# SMTP_USER=zoneminder@example.com
# SMTP_PASS=
# SMTP_FROM=zoneminder@example.com

# Host ports
ZM_HTTP_PORT=8080
GO2RTC_API_PORT=1984
GO2RTC_WEBRTC_PORT=8555
ZMES_PORT=9000

# Size of /dev/shm in bytes (1 GiB). Raise it for many or high resolution monitors.
ZM_SHM_SIZE=1073741824

# Event server, only read the first time /config/es/*.yml is created.
# Set ZMES_USE_HOOKS=yes and start with --profile ml for object detection.
ZMES_USE_HOOKS=no
ZMES_ML_GATEWAY=http://pyzm-serve:5000

# Models pyzm-serve downloads and serves, comma separated. "Name=file" publishes file.onnx
# under the name objectconfig.yml asks for, e.g. "YOLO ONNX=yolo11s" or "YOLO ONNX=yolo26s".
PYZM_MODELS=YOLO ONNX=yolo11s

# GPU detection: add -f compose.gpu.yaml. It uses the pyzm-serve:cuda image.
# PYZM_CUDA_TAG=cuda
# PYZM_GPU_COUNT=1
